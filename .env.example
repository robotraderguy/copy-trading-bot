# ============================================================
#  THIS FILE IS THE ENTIRE CONFIGURATION. There is no database
#  and no settings screen: the accounts, their sizing, and every
#  switch live here.
#
#  Copy to `.env` and fill it in. Never commit the real one.
# ============================================================

# --- The accounts -------------------------------------------
# Numbered slots. ACCOUNT_1 is the MASTER — the account you trade
# by hand. Every slot after it is a follower that mirrors it.
#
# Each slot needs a key and a secret (Alpaca uses a PAIR; one
# value is not enough), plus an alias, which is the ONLY name
# shown on screen — account numbers never appear in the app.
#
# Add a follower by adding the next numbered slot and restarting.
# Stop at the first missing number: a gap ends the list.
#
# THREE SLOTS IS AN EXAMPLE, NOT A REQUIREMENT. One master and one
# follower works fine. If you only have two accounts, either delete
# the third slot or leave it exactly as it is -- a slot still holding
# the placeholder text below is treated as unfilled, reported on the
# dashboard, and skipped. The other accounts keep working.
#
# PAPER ONLY. https://alpaca.markets -> Paper Trading -> API keys
# Never put live-money credentials in this file.

ACCOUNT_1_ALIAS=Main
ACCOUNT_1_KEY=your_paper_api_key_here
ACCOUNT_1_SECRET=your_paper_api_secret_here

ACCOUNT_2_ALIAS=Roth
ACCOUNT_2_KEY=your_paper_api_key_here
ACCOUNT_2_SECRET=your_paper_api_secret_here
# How this follower sizes its copies. Either a multiplier on the
# master's quantity, or a fixed share count that ignores it.
#
# DEFAULTS TO 2 ON PURPOSE. A follower set to 1 copies the master's
# quantity exactly, which looks identical to a follower that ignores
# the setting entirely -- so the one number that proves sizing works
# is the one number you cannot see working. At 2, buying 100 on the
# master puts 200 here and 50 in the account below, and the three
# rows read as a rule rather than a copy.
ACCOUNT_2_MULTIPLIER=2
# ACCOUNT_2_FIXED_SHARES=10

ACCOUNT_3_ALIAS=Long-term
ACCOUNT_3_KEY=your_paper_api_key_here
ACCOUNT_3_SECRET=your_paper_api_secret_here
ACCOUNT_3_MULTIPLIER=0.5

# --- The copier ---------------------------------------------
# The killswitch. OFF by default, on purpose: the first thing a
# freshly deployed copier does must never be to place orders.
# It stops NEW copies only — it does not cancel orders already
# placed or close positions already opened.
COPYING_ENABLED=false

# Seconds between passes. Faster is not better: every pass costs
# broker calls, and brokers rate-limit at the worst moment.
POLL_SECONDS=5

# Ignore master orders older than this many seconds. Stops a
# copier that has been down from waking up and firing a backlog
# at prices that have long since moved.
STALE_ORDER_SECONDS=300

# --- Web ----------------------------------------------------
# Flask session signing key. Any long random string; never reuse
# one you have published anywhere.
FLASK_SECRET_KEY=pick_a_long_random_string
